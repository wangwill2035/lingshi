FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", "个人小工具"
            VALUE "FileDescription", "入库上架二维码打印工具"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "QRPrinter"
            VALUE "OriginalFilename", "入库上架二维码打印工具.exe"
            VALUE "ProductName", "入库上架二维码打印工具"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
